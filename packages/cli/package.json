{
  "name": "safedeps",
  "version": "1.2.0",
  "description": "Open source npm package security scanner — catch supply chain attacks before they catch you.",
  "bin": {
    "safedeps": "dist/bin/safedeps.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc && mkdir -p dist/data && cp data/top-packages.json dist/data/top-packages.json && cp package.json dist/package.json",
    "dev": "ts-node bin/safedeps.ts",
    "test": "node --require ts-node/register --test tests/*.test.ts",
    "lint": "eslint src/ --ext .ts"
  },
  "keywords": [
    "npm",
    "security",
    "supply-chain",
    "typosquatting",
    "cve",
    "vulnerability",
    "scanner"
  ],
  "author": "Deepak Kumar Saini",
  "license": "AGPL-3.0",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "ora": "^7.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "eslint": "^8.55.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
